// Version resource for BASSPlAIer.exe.
// The build passes the version on the rc command line:
//   rc /d APP_VERSION=1.2.3 /d APP_VERSION_NUM=1,2,3,0 version.rc
// Defaults keep a plain local "rc version.rc" working.

#include <winver.h>

#ifndef APP_VERSION
#define APP_VERSION 0.0.0
#endif
#ifndef APP_VERSION_NUM
#define APP_VERSION_NUM 0,0,0,0
#endif

// stringize the dotted version (1.2.3 -> "1.2.3")
#define STR2(s) #s
#define STR(s)  STR2(s)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // US English, Unicode
        BEGIN
            VALUE "ProductName",      "BASS PlAIer"
            VALUE "ProductVersion",   STR(APP_VERSION)
            VALUE "FileVersion",      STR(APP_VERSION)
            VALUE "FileDescription",  "BASS PlAIer audio player"
            VALUE "CompanyName",      "MarcroSoft"
            VALUE "OriginalFilename", "BASSPlAIer.exe"
            VALUE "LegalCopyright",   "MarcroSoft"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
